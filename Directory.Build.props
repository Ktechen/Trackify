<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run the IDE code-style analyzers during build so the namespace rules (IDE0130/IDE0161) are enforced. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      CS7064: Uno.Resizetizer can generate the wasm favicon.ico after the compiler first references
      it (mostly on clean builds), so keep this one a warning instead of a hard error.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS7064</WarningsNotAsErrors>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
      MVVMTK0045: WinRT-AOT advice to use partial properties; we use field-based [ObservableProperty]
                  on purpose (keeps default values readable) and don't target WinRT AOT.
      NETSDK1198: Windows head has no publish profile - only relevant when packaging for the Store.
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257;MVVMTK0045;NETSDK1198</NoWarn>
  </PropertyGroup>

  <!--
    ============================= Release version =============================
    THE single source of truth for Trackify's version. Bump it in the PR that prepares a release,
    then tag that commit `v<TrackifyVersion>`. Everything downstream derives from this one property:

      * Version / assembly + file version        - every project (set below)
      * ApplicationDisplayVersion                - Uno app: Android versionName, and the first three
                                                   parts of the MSIX package version
      * ApplicationVersion (TrackifyVersionCode) - Uno app: Android versionCode, iOS CFBundleVersion.
                                                   NOT the MSIX fourth part - the Windows head
                                                   overrides it to 0, because the Microsoft Partner
                                                   Center reserves that part and rejects anything
                                                   else. See Source/Trackify/Trackify.csproj.
      * the .deb package version                 - .github/scripts/build-deb.sh, from the tag
      * the GitHub Release name                  - .github/workflows/release.yml

    `release.yml` refuses to publish when the tag and this property disagree, so a mistyped tag can
    never ship artifacts labelled with a different version than they were built with. Both are
    overridable on the command line (`-p:TrackifyVersion=...`) for test builds.
    ===========================================================================
  -->
  <PropertyGroup>
    <TrackifyVersion Condition="'$(TrackifyVersion)' == ''">1.0.0</TrackifyVersion>
    <Version>$(TrackifyVersion)</Version>

    <!--
      Android's versionCode is a single integer that MUST increase with every release or the platform
      refuses the update (iOS CFBundleVersion behaves the same way). Deriving it from TrackifyVersion
      leaves just one number to maintain: two digits each for minor and patch, so 1.0.0 -> 10000 and
      1.2.3 -> 10203. Minor and patch therefore have to stay below 100, or the mapping stops being
      monotonic (1.0.100 would collide with 1.1.0) - bump the minor rather than let a patch number
      reach three digits. Windows does not use this integer at all; see the note above.
    -->
    <_TrackifyVersionMajor>$(TrackifyVersion.Split('.')[0])</_TrackifyVersionMajor>
    <_TrackifyVersionMinor>$(TrackifyVersion.Split('.')[1])</_TrackifyVersionMinor>
    <_TrackifyVersionPatch>$(TrackifyVersion.Split('.')[2])</_TrackifyVersionPatch>
    <TrackifyVersionCode Condition="'$(TrackifyVersionCode)' == ''">$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_TrackifyVersionMajor), 10000)), $([MSBuild]::Multiply($(_TrackifyVersionMinor), 100)))), $(_TrackifyVersionPatch)))</TrackifyVersionCode>
  </PropertyGroup>
</Project>
