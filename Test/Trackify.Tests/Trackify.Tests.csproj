<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xUnit analyzers are strict; a test project shouldn't fail the build on their style nits. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!--
      Coverage scope. The target is 100% line / >=90% branch on code that can actually run here, so
      the parts that cannot are excluded deliberately rather than papered over with tests that mock
      the hardware away:
        Infrastructure/Ble    - BlueZ over D-Bus; needs a Raspberry Pi with a real radio.
        Application/Services  - Plugin.BLE and WinRT transports; compile only on their own heads.
      Measure with: dotnet test ... -p:CollectCoverage=true -p:CoverletOutputFormat=cobertura
      Threshold is deliberately NOT set yet: it would fail every build until the scope is covered.
    -->
    <Exclude>[Trackify.Infrastructure]Trackify.Infrastructure.Ble.*,[Trackify.Application]Trackify.Application.Services.*</Exclude>
    <ExcludeByFile>**/Platforms/**/*.cs,**/*.g.cs,**/*.g.i.cs</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="coverlet.msbuild" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Trackify.Domain\Trackify.Domain.csproj" />
    <ProjectReference Include="..\..\Source\Trackify.Application\Trackify.Application.csproj" />
    <ProjectReference Include="..\..\Source\Trackify.Infrastructure\Trackify.Infrastructure.csproj" />
    <!-- The CLI is referenced only so the architecture tests can assert the front-end never
         depends on the Domain entity namespace (the DTO boundary). -->
    <ProjectReference Include="..\..\Source\Trackify.Cli\Trackify.Cli.csproj" />
  </ItemGroup>

</Project>
