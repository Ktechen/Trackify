<Page x:Class="Trackify.Presentation.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Trackify.Presentation.Components"
      xmlns:widgets="using:Trackify.Presentation.Widgets"
      xmlns:behaviors="using:Trackify.Presentation.Behaviors"
      xmlns:vm="using:Trackify.Presentation.ViewModels"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- HEADER — background fills behind the status bar; content is padded into the safe area. -->
    <Grid Grid.Row="0"
          Padding="16,12"
          utu:SafeArea.Insets="Top,Left,Right"
          Background="{ThemeResource SurfaceBrush}"
          BorderBrush="{ThemeResource SurfaceVariantBrush}"
          BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Back to list (narrow layout only; toggled from code-behind) -->
      <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0"
              Visibility="Collapsed" Command="{Binding BackToListCommand}" ToolTipService.ToolTip="Zurück zur Liste">
        <FontIcon Glyph="&#xE72B;" FontSize="16" />
      </Button>

      <Border Grid.Column="1" Width="42" Height="42" Background="{ThemeResource PrimaryContainerBrush}"
              BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1" Margin="0,0,14,0">
        <Grid Width="24" Height="24">
          <Path Data="M5 4h11a3 3 0 0 1 3 3v8H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" Fill="{ThemeResource OnPrimaryContainerBrush}" />
          <Ellipse Width="4" Height="4" Fill="{ThemeResource OnPrimaryContainerBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,16,0,0" />
          <Ellipse Width="4" Height="4" Fill="{ThemeResource OnPrimaryContainerBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,16,0,0" />
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="Train-Konfiguration" FontFamily="{StaticResource HeadingFontFamily}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Powered Up · Legoino-Schnittstelle" Style="{StaticResource MonoCaptionTextBlockStyle}" />
      </StackPanel>

      <StackPanel x:Name="HeaderStats" Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock Text="{Binding ActiveCount}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="aktiv ·" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        <TextBlock Text="{Binding TotalCount}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="gesamt" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>

      <!-- Visibility owned by ApplyResponsiveLayout in code-behind (depends on width AND selection). -->
      <Border x:Name="HeaderChip" Grid.Column="5" Style="{StaticResource ChipBorderStyle}" Margin="0,0,10,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                    Fill="{Binding SelectedTrain.IsHardwareConnected, Converter={StaticResource BoolToStatusBrushConverter}}" />
          <TextBlock Text="{Binding SelectedTrain.ConnectionStatus}" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleConnectionPanelCommand}" ToolTipService.ToolTip="Verbindung (Direkt/Server)">
          <FontIcon Glyph="&#xE713;" FontSize="16" />
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding GoToStreckenplanerCommand}" ToolTipService.ToolTip="Streckenplaner öffnen">
          <FontIcon Glyph="&#xE8A1;" FontSize="16" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- CONTENT: responsive master-detail (columns/visibility driven by code-behind). The splitter
         column lets the list pane be dragged wider/narrower on desktop (SplitterColumn.Width=0,
         handle collapsed, in the narrow layout — there's nothing to split there). -->
    <Grid x:Name="ContentGrid" Grid.Row="1" utu:SafeArea.Insets="Bottom,Left,Right">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="346" />
        <ColumnDefinition x:Name="SplitterColumn" Width="6" />
        <ColumnDefinition x:Name="EditorColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <local:TrainListPanel x:Name="ListPanel" Grid.Column="0" />
      <Border x:Name="SplitterHandle" Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch"
              behaviors:ColumnSplitterBehavior.Target="{Binding ElementName=ListColumn}"
              behaviors:ColumnSplitterBehavior.MinWidth="260" behaviors:ColumnSplitterBehavior.MaxWidth="480">
        <Rectangle Width="1" Fill="{ThemeResource OutlineVariantBrush}" HorizontalAlignment="Center" />
      </Border>
      <local:TrainEditor x:Name="EditorHost" Grid.Column="2" />
    </Grid>

    <!-- ADD-HUB POPUP (modal overlay across the whole page) -->
    <local:AddHubDialog Grid.Row="0" Grid.RowSpan="2" />

    <!-- CONNECTION PANEL — inline modal overlay toggled from the header (Direct vs Server, live switch) -->
    <Grid Grid.Row="0" Grid.RowSpan="2"
          Background="#99000000"
          Visibility="{Binding IsConnectionPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
      <widgets:BlueprintFrame VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="380" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="1" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="Verbindung" FontFamily="{StaticResource HeadingFontFamily}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       Text="Servermodus: Steuerung über einen Trackify-Backend (Raspberry Pi). Aus = Direktmodus über das Bluetooth dieses Geräts." />
            <ToggleSwitch Header="Server verwenden" OnContent="Server" OffContent="Direkt"
                          IsOn="{Binding Connection.UseServer, Mode=TwoWay}" />
            <TextBox Header="Server-Adresse" PlaceholderText="http://192.168.1.50:5000"
                     IsEnabled="{Binding Connection.UseServer}"
                     Text="{Binding Connection.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       Text="{Binding ConnectionStatus}"
                       Visibility="{Binding ConnectionStatus, Converter={StaticResource NullToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Schließen" Style="{StaticResource IconButtonStyle}" Width="Auto" Padding="16,0" Height="40" Command="{Binding ToggleConnectionPanelCommand}" />
              <Button Content="Übernehmen" Style="{StaticResource FabButtonStyle}" Height="40" Command="{Binding ApplyConnectionCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </widgets:BlueprintFrame>
    </Grid>
  </Grid>
</Page>
