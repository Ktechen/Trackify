<Page x:Class="Trackify.Presentation.Pages.SecondPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Trackify.Presentation.Components"
      xmlns:vm="using:Trackify.Presentation.ViewModels"
      xmlns:behaviors="using:Trackify.Presentation.Behaviors"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SecondViewModel}"
      Background="{ThemeResource BackgroundBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- HEADER — background fills behind the status bar; content is padded into the safe area.
         The title column is the one that gives way (it trims), so the list button and "Speichern"
         are never pushed off the right edge: on a 360dp phone the fixed parts alone take ~250px. -->
    <Grid Grid.Row="0"
          Padding="16,12"
          utu:SafeArea.Insets="Top,Left,Right"
          Background="{ThemeResource SurfaceBrush}"
          BorderBrush="{ThemeResource SurfaceVariantBrush}"
          BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Command="{Binding GoBackCommand}"
              AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="Zurück zur Train-Konfiguration"
              Margin="0,0,10,0" ToolTipService.ToolTip="Zurück zur Train-Konfiguration">
        <FontIcon Glyph="&#xE72B;" FontSize="16" />
      </Button>

      <!-- The emblem is the first thing to go when the width is tight: it costs 56px and says nothing
           the title does not. -->
      <Border Grid.Column="1" Width="42" Height="42" Background="{ThemeResource PrimaryContainerBrush}"
              BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1" Margin="0,0,14,0"
              Visibility="{Binding IsRoomy, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid Width="24" Height="24">
          <Path Data="M4 7h16M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2M4 7v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7"
                Stroke="{ThemeResource OnPrimaryContainerBrush}" StrokeThickness="2" />
          <Ellipse Width="3.2" Height="3.2" Fill="{ThemeResource OnPrimaryContainerBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6.9,17.4,0,0" />
          <Ellipse Width="3.2" Height="3.2" Fill="{ThemeResource OnPrimaryContainerBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13.9,17.4,0,0" />
          <Path Data="M8 15v3M16 15v3" Stroke="{ThemeResource OnPrimaryContainerBrush}" StrokeThickness="1.6" />
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
        <TextBlock Text="Streckenplaner" FontFamily="{StaticResource HeadingFontFamily}" FontSize="18" FontWeight="SemiBold"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Zeichnen · echte LEGO-Teile" Style="{StaticResource MonoCaptionTextBlockStyle}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding IsRoomy, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>

      <!-- Compact only: the parts list is a sheet there, so it needs a way in. It doubles as the
           count the wide header shows in full. -->
      <Button Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
              Style="{StaticResource OutlinedButtonStyle}" Padding="12,0"
              Command="{Binding TogglePieceListCommand}"
              AutomationProperties.Name="Teileliste" ToolTipService.ToolTip="Teileliste zeigen oder schließen"
              Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <FontIcon Glyph="&#xE8FD;" FontSize="13" />
          <TextBlock Text="{Binding PieceCount}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="SemiBold" />
        </StackPanel>
      </Button>

      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0"
                  Visibility="{Binding IsRoomy, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding PieceCount}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="Teile" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        <TextBlock Text="{Binding SensorCount}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" />
        <TextBlock Text="Sensoren" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        <TextBlock Text="{Binding OpenEndCount}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" />
        <TextBlock Text="offen" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>

      <Button Grid.Column="5" Style="{StaticResource OutlinedButtonStyle}" Content="Speichern"
              Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}" />
    </Grid>

    <!-- CONTENT: canvas+toolbar always visible; the strand list and segment inspector swap between a
         3-column desktop/tablet layout and a stacked mobile layout (inspector as a bottom sheet,
         visible only while a segment is selected) — columns/rows/visibility owned by code-behind. -->
    <Grid x:Name="ContentGrid" Grid.Row="1" utu:SafeArea.Insets="Bottom,Left,Right">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CanvasColumn" Width="*" />
        <ColumnDefinition x:Name="Splitter1Column" Width="6" />
        <ColumnDefinition x:Name="ListColumn" Width="260" />
        <ColumnDefinition x:Name="Splitter2Column" Width="6" />
        <ColumnDefinition x:Name="InspectorColumn" Width="340" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="CanvasRow" />
        <RowDefinition x:Name="ListRow" Height="0" />
      </Grid.RowDefinitions>

      <local:TrackCanvas x:Name="CanvasHost" Grid.Column="0" Grid.Row="0" />

      <Border x:Name="Splitter1Handle" Grid.Column="1" Grid.Row="0" Background="Transparent" HorizontalAlignment="Stretch"
              behaviors:ColumnSplitterBehavior.Target="{Binding ElementName=ListColumn}" behaviors:ColumnSplitterBehavior.Invert="True"
              behaviors:ColumnSplitterBehavior.MinWidth="240" behaviors:ColumnSplitterBehavior.MaxWidth="420">
        <Rectangle Width="1" Fill="{ThemeResource OutlineVariantBrush}" HorizontalAlignment="Center" />
      </Border>
      <!-- Opaque, because in the compact layout this same control is a sheet laid over the canvas
           (the inspector beside it already carries a surface for the same reason). -->
      <local:PieceList x:Name="ListHost" Grid.Column="2" Grid.Row="0"
                       Background="{ThemeResource SurfaceBrush}"
                       BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1,0,0,0" />

      <Border x:Name="Splitter2Handle" Grid.Column="3" Grid.Row="0" Background="Transparent" HorizontalAlignment="Stretch"
              behaviors:ColumnSplitterBehavior.Target="{Binding ElementName=InspectorColumn}" behaviors:ColumnSplitterBehavior.Invert="True"
              behaviors:ColumnSplitterBehavior.MinWidth="320" behaviors:ColumnSplitterBehavior.MaxWidth="560">
        <Rectangle Width="1" Fill="{ThemeResource OutlineVariantBrush}" HorizontalAlignment="Center" />
      </Border>
      <local:SegmentInspector x:Name="InspectorHost" Grid.Column="4" Grid.Row="0"
                               Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1,0,0,0" />
    </Grid>
  </Grid>
</Page>
