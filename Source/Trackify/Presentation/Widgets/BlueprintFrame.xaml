<UserControl x:Class="Trackify.Presentation.Widgets.BlueprintFrame"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Corner marks straddle the wrapped content's edge (6px out, 5px in) — see styles.css
       ".blueprint > .corner". Non-hit-testable so they never intercept pointer input. -->
  <Grid>
    <ContentPresenter Content="{Binding FrameContent, ElementName=Root}" />

    <Grid Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" IsHitTestVisible="False">
      <Rectangle Width="1" Height="11" Fill="{ThemeResource OutlineBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" />
      <Rectangle Width="11" Height="1" Fill="{ThemeResource OutlineBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
    </Grid>
    <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" IsHitTestVisible="False">
      <Rectangle Width="1" Height="11" Fill="{ThemeResource OutlineBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" />
      <Rectangle Width="11" Height="1" Fill="{ThemeResource OutlineBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
    </Grid>
    <Grid Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6" IsHitTestVisible="False">
      <Rectangle Width="1" Height="11" Fill="{ThemeResource OutlineBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" />
      <Rectangle Width="11" Height="1" Fill="{ThemeResource OutlineBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
    </Grid>
    <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" IsHitTestVisible="False">
      <Rectangle Width="1" Height="11" Fill="{ThemeResource OutlineBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" />
      <Rectangle Width="11" Height="1" Fill="{ThemeResource OutlineBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
    </Grid>
  </Grid>
</UserControl>
