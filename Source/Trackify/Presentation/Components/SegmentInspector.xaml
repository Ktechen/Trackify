<UserControl x:Class="Trackify.Presentation.Components.SegmentInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Trackify.Presentation.Widgets"
             xmlns:behaviors="using:Trackify.Presentation.Behaviors"
             xmlns:vm="using:Trackify.Presentation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecondViewModel}">

  <!-- Selected-segment inspector (drive behaviour + sensor). Binds to the hosting SecondViewModel.
       No border of its own: SecondPage draws the pane's hairline, and two of them read as a double line. -->
  <Grid Background="{ThemeResource SurfaceBrush}">
    <ScrollViewer Visibility="{Binding SelectedPiece, Converter={StaticResource NullToVisibilityConverter}}"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
      <Grid Margin="24,24,24,40">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="FahrverhaltenRow" Height="320" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="SensorRow" Height="260" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
        <!-- Grid, not a horizontal StackPanel: the id has to trim to the pane width, and a
             StackPanel would measure it with infinite width and let it overflow the pane. -->
        <Grid ColumnSpacing="11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                  Background="{Binding SelectedPiece.SpeedColor, Converter={StaticResource HexToBrushConverter}}" />
          <Border Grid.Column="1" Style="{StaticResource TagAccentStyle}" Padding="10,3">
            <TextBlock Text="{Binding SelectedPiece.TypeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
          </Border>
          <TextBlock Grid.Column="2" Text="{Binding SelectedPiece.Id}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                     Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" TextAlignment="Right"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <!-- The way out of the inspector. On a phone it is a bottom sheet over the canvas, and every
               drawn run selects the piece it laid - without this it would stay over the drawing. -->
          <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Command="{Binding ClearSelectionCommand}"
                  AutomationProperties.Name="Auswahl schließen" ToolTipService.ToolTip="Schließen">
            <FontIcon Glyph="&#xE711;" FontSize="13" />
          </Button>
        </Grid>
        <TextBox Text="{Binding SelectedPiece.Name, Mode=TwoWay}" FontFamily="{StaticResource HeadingFontFamily}" FontSize="22" FontWeight="SemiBold"
                 Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Name des Teils" />
        </StackPanel>

        <!-- FAHRVERHALTEN -->
        <local:BlueprintFrame Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Border Style="{StaticResource SectionCardStyle}" Padding="20">
          <StackPanel Spacing="16">
            <TextBlock Text="Fahrverhalten" Style="{StaticResource SectionTitleTextBlockStyle}" FontWeight="Bold" />

            <StackPanel Spacing="11">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Max. Geschwindigkeit" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <TextBlock Text="{Binding SelectedPiece.MaxSpeed}" FontFamily="{StaticResource MonoFontFamily}" FontSize="17" FontWeight="ExtraBold"
                             Foreground="{Binding SelectedPiece.SpeedColor, Converter={StaticResource HexToBrushConverter}}" />
                  <TextBlock Text="%" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
              </Grid>
              <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{Binding SelectedPiece.MaxSpeed, Mode=TwoWay}"
                      AutomationProperties.Name="Max. Geschwindigkeit" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Fahrtrichtung" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vorwärts" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedPiece.Direction, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Forward}"
                        Foreground="{Binding SelectedPiece.Direction, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Forward}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="Forward" />
                <Button Grid.Column="1" Content="Rückwärts" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedPiece.Direction, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Reverse}"
                        Foreground="{Binding SelectedPiece.Direction, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Reverse}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="Reverse" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Geschwindigkeitsprofil f(x)" Style="{StaticResource LabelTextBlockStyle}" />
              <local:SpeedProfileWidget Graph="{Binding SelectedPiece.Graph}" />

              <!-- Stacked, as in the train editor: two-up in a 340px inspector each box gets ~120px, which
                   cuts "Exponentiell" and the longer formulas. -->
              <StackPanel Spacing="14">
                <StackPanel Spacing="7">
                  <TextBlock Text="Beschleunigung" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <ComboBox ItemsSource="{Binding SpeedFunctionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                            SelectedValue="{Binding SelectedPiece.AccelFn, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Beschleunigung" />
                  <TextBlock Text="{Binding SelectedPiece.AccelFormulaDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                             Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="7">
                  <TextBlock Text="Bremsen" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <ComboBox ItemsSource="{Binding SpeedFunctionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                            SelectedValue="{Binding SelectedPiece.BrakeFn, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Bremsen" />
                  <TextBlock Text="{Binding SelectedPiece.BrakeFormulaDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                             Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
        </ScrollViewer>
        </local:BlueprintFrame>

        <Border Grid.Row="2" Height="16" Background="Transparent" VerticalAlignment="Stretch"
                behaviors:RowSplitterBehavior.Target="{Binding ElementName=FahrverhaltenRow}"
                behaviors:RowSplitterBehavior.MinHeight="160" behaviors:RowSplitterBehavior.MaxHeight="900">
          <Rectangle Height="1" Fill="{ThemeResource OutlineVariantBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- WEICHE -->
        <local:BlueprintFrame Grid.Row="3" Visibility="{Binding SelectedPiece.IsSwitch, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Style="{StaticResource SectionCardStyle}" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="Weiche" Style="{StaticResource SectionTitleTextBlockStyle}" FontWeight="Bold" />

            <!-- Which way the branch peels off is the part itself now ("Weiche links" vs "Weiche
                 rechts"), and where the branch leads is whatever is plugged into its branch port —
                 both are the plan's geometry, not settings. What is left to decide here is how the
                 point stands. -->
            <StackPanel Spacing="10">
              <TextBlock Text="Gestellt auf" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Stammgleis" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedPiece.DefaultRoute, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Main}"
                        Foreground="{Binding SelectedPiece.DefaultRoute, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Main}"
                        Command="{Binding SetRouteCommand}" CommandParameter="Main" />
                <Button Grid.Column="1" Content="Zweig" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedPiece.DefaultRoute, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Branch}"
                        Foreground="{Binding SelectedPiece.DefaultRoute, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Branch}"
                        Command="{Binding SetRouteCommand}" CommandParameter="Branch" />
              </Grid>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       Text="Welcher Motor diese Weiche stellt und wo ihr Sensor hängt, trägt der Streckenplan schon mit und wandert beim Export mit. Einstellbar wird es hier, wenn die Ansteuerung kommt." />
          </StackPanel>
        </Border>
        </local:BlueprintFrame>

        <Border Grid.Row="4" Height="16" Background="Transparent" VerticalAlignment="Stretch"
                behaviors:RowSplitterBehavior.Target="{Binding ElementName=SensorRow}" behaviors:RowSplitterBehavior.Invert="True"
                behaviors:RowSplitterBehavior.MinHeight="140" behaviors:RowSplitterBehavior.MaxHeight="700">
          <Rectangle Height="1" Fill="{ThemeResource OutlineVariantBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- SENSOR -->
        <local:BlueprintFrame Grid.Row="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Border Style="{StaticResource SectionCardStyle}" Padding="20">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="Sensor" Style="{StaticResource SectionTitleTextBlockStyle}" FontWeight="Bold" />
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding SelectedPiece.SensorColor, Converter={StaticResource HexToBrushConverter}}"
                       Visibility="{Binding SelectedPiece.HasSensor, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Typ" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Kein" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedPiece.Sensor, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=None}"
                        Foreground="{Binding SelectedPiece.Sensor, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=None}"
                        Command="{Binding SetSensorCommand}" CommandParameter="None" />
                <Button Grid.Column="1" Content="Farbe" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedPiece.Sensor, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Color}"
                        Foreground="{Binding SelectedPiece.Sensor, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Color}"
                        Command="{Binding SetSensorCommand}" CommandParameter="Color" />
                <Button Grid.Column="2" Content="Abstand" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedPiece.Sensor, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Distance}"
                        Foreground="{Binding SelectedPiece.Sensor, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Distance}"
                        Command="{Binding SetSensorCommand}" CommandParameter="Distance" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="18" Visibility="{Binding SelectedPiece.HasSensor, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Spacing="8">
                <TextBlock Text="Aktion beim Auslösen" Style="{StaticResource LabelTextBlockStyle}" />
                <ComboBox ItemsSource="{Binding SensorActionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedPiece.Action, Mode=TwoWay}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Aktion beim Auslösen" />
              </StackPanel>

              <StackPanel Spacing="10" Visibility="{Binding SelectedPiece.ShowSlowTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Ziel-Tempo" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{Binding SelectedPiece.SlowTarget}" FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="%" FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold" />
                  </StackPanel>
                </Grid>
                <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{Binding SelectedPiece.SlowTarget, Mode=TwoWay}"
                        AutomationProperties.Name="Ziel-Tempo" />
              </StackPanel>

              <TextBlock Text="{Binding SelectedPiece.SensorToken}" Style="{StaticResource MonoCaptionTextBlockStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>
        </ScrollViewer>
        </local:BlueprintFrame>

        <!-- Reorder and duplicate are gone with the chain: in a graph a part has no "position in the
             list", it has ports. Building happens on the canvas; what is left here is removing the
             selected part. -->
        <Button Grid.Row="6" Margin="0,16,0,0" HorizontalAlignment="Stretch" Content="Teil löschen"
                Style="{StaticResource OutlinedButtonStyle}" Foreground="{ThemeResource ErrorBrush}"
                Command="{Binding DeletePieceCommand}" CommandParameter="{Binding SelectedPiece}" />

      </Grid>
    </ScrollViewer>

    <StackPanel Visibility="{Binding SelectedPiece, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
      <TextBlock Text="Kein Teil ausgewählt. Tippe ein Teil auf der Fläche an." FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
