<UserControl x:Class="Trackify.Presentation.Components.SegmentInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Trackify.Presentation.Widgets"
             xmlns:behaviors="using:Trackify.Presentation.Behaviors"
             xmlns:vm="using:Trackify.Presentation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecondViewModel}">

  <!-- Selected-segment inspector (drive behaviour + sensor). Binds to the hosting SecondViewModel. -->
  <Grid Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceVariantBrush}" BorderThickness="1,0,0,0">
    <ScrollViewer Visibility="{Binding SelectedSegment, Converter={StaticResource NullToVisibilityConverter}}"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
      <Grid Margin="24,24,24,40">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="FahrverhaltenRow" Height="320" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="SensorRow" Height="260" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
        <!-- Grid, not a horizontal StackPanel: the GUID has to trim to the pane width, and a
             StackPanel would measure it with infinite width and let it overflow the pane. -->
        <Grid ColumnSpacing="11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                  Background="{Binding SelectedSegment.SpeedColor, Converter={StaticResource HexToBrushConverter}}" />
          <Border Grid.Column="1" Style="{StaticResource TagAccentStyle}" Padding="10,3">
            <TextBlock Text="{Binding SelectedSegment.TypeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
          </Border>
          <TextBlock Grid.Column="2" Text="{Binding SelectedSegment.Id}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                     Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" TextAlignment="Right"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBox Text="{Binding SelectedSegment.Name, Mode=TwoWay}" FontFamily="{StaticResource HeadingFontFamily}" FontSize="22" FontWeight="SemiBold"
                 Background="Transparent" BorderThickness="0" Padding="0" />
        </StackPanel>

        <!-- FAHRVERHALTEN -->
        <local:BlueprintFrame Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Border Style="{StaticResource SectionCardStyle}" Padding="20">
          <StackPanel Spacing="16">
            <TextBlock Text="Fahrverhalten" Style="{StaticResource SectionTitleTextBlockStyle}" FontWeight="Bold" />

            <StackPanel Spacing="11">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Max. Geschwindigkeit" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <TextBlock Text="{Binding SelectedSegment.MaxSpeed}" FontFamily="{StaticResource MonoFontFamily}" FontSize="17" FontWeight="ExtraBold"
                             Foreground="{Binding SelectedSegment.SpeedColor, Converter={StaticResource HexToBrushConverter}}" />
                  <TextBlock Text="%" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
              </Grid>
              <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{Binding SelectedSegment.MaxSpeed, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Fahrtrichtung" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vorwärts" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedSegment.Direction, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Forward}"
                        Foreground="{Binding SelectedSegment.Direction, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Forward}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="Forward" />
                <Button Grid.Column="1" Content="Rückwärts" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedSegment.Direction, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Reverse}"
                        Foreground="{Binding SelectedSegment.Direction, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Reverse}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="Reverse" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Geschwindigkeitsprofil f(x)" Style="{StaticResource LabelTextBlockStyle}" />
              <local:SpeedProfileWidget Graph="{Binding SelectedSegment.Graph}" />

              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="7">
                  <TextBlock Text="Beschleunigung" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <ComboBox ItemsSource="{Binding SpeedFunctionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                            SelectedValue="{Binding SelectedSegment.AccelFn, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="{Binding SelectedSegment.AccelFormulaDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7">
                  <TextBlock Text="Bremsen" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <ComboBox ItemsSource="{Binding SpeedFunctionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                            SelectedValue="{Binding SelectedSegment.BrakeFn, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="{Binding SelectedSegment.BrakeFormulaDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        </ScrollViewer>
        </local:BlueprintFrame>

        <Border Grid.Row="2" Height="16" Background="Transparent" VerticalAlignment="Stretch"
                behaviors:RowSplitterBehavior.Target="{Binding ElementName=FahrverhaltenRow}"
                behaviors:RowSplitterBehavior.MinHeight="160" behaviors:RowSplitterBehavior.MaxHeight="900">
          <Rectangle Height="1" Fill="{ThemeResource OutlineVariantBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- WEICHE -->
        <local:BlueprintFrame Grid.Row="3" Visibility="{Binding SelectedSegment.IsWeiche, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Style="{StaticResource SectionCardStyle}" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="Weiche" Style="{StaticResource SectionTitleTextBlockStyle}" FontWeight="Bold" />

            <StackPanel Spacing="10">
              <TextBlock Text="Zweig" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Nach links" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedSegment.BranchDirection, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Left}"
                        Foreground="{Binding SelectedSegment.BranchDirection, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Left}"
                        Command="{Binding SetBranchDirectionCommand}" CommandParameter="Left" />
                <Button Grid.Column="1" Content="Nach rechts" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedSegment.BranchDirection, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Right}"
                        Foreground="{Binding SelectedSegment.BranchDirection, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Right}"
                        Command="{Binding SetBranchDirectionCommand}" CommandParameter="Right" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Gestellt auf" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Stammgleis" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedSegment.Route, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Main}"
                        Foreground="{Binding SelectedSegment.Route, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Main}"
                        Command="{Binding SetRouteCommand}" CommandParameter="Main" />
                <Button Grid.Column="1" Content="Zweig" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedSegment.Route, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Branch}"
                        Foreground="{Binding SelectedSegment.Route, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Branch}"
                        Command="{Binding SetRouteCommand}" CommandParameter="Branch" />
              </Grid>
            </StackPanel>

            <Grid ColumnSpacing="9" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding SelectedBranchName}" FontFamily="{StaticResource HeadingFontFamily}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedBranchCount}" Style="{StaticResource MonoCaptionTextBlockStyle}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Im Zweig bauen" Style="{StaticResource IconButtonStyle}" Width="Auto" Height="36" Padding="12,0"
                      Command="{Binding GotoBranchCommand}" />
            </Grid>

            <StackPanel Spacing="7">
              <TextBlock Text="Zweig-Ende anschließen an" Style="{StaticResource LabelTextBlockStyle}" />
              <ComboBox ItemsSource="{Binding BranchLinkOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                        SelectedValue="{Binding SelectedSegment.BranchLinkSegmentId, Mode=TwoWay}"
                        PlaceholderText="— offen lassen —" HorizontalAlignment="Stretch" />
            </StackPanel>
          </StackPanel>
        </Border>
        </local:BlueprintFrame>

        <Border Grid.Row="4" Height="16" Background="Transparent" VerticalAlignment="Stretch"
                behaviors:RowSplitterBehavior.Target="{Binding ElementName=SensorRow}" behaviors:RowSplitterBehavior.Invert="True"
                behaviors:RowSplitterBehavior.MinHeight="140" behaviors:RowSplitterBehavior.MaxHeight="700">
          <Rectangle Height="1" Fill="{ThemeResource OutlineVariantBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- SENSOR -->
        <local:BlueprintFrame Grid.Row="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Border Style="{StaticResource SectionCardStyle}" Padding="20">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="Sensor" Style="{StaticResource SectionTitleTextBlockStyle}" FontWeight="Bold" />
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding SelectedSegment.SensorColor, Converter={StaticResource HexToBrushConverter}}"
                       Visibility="{Binding SelectedSegment.HasSensor, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Typ" Style="{StaticResource LabelTextBlockStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Kein" Style="{StaticResource SegmentPillButtonStyle}"
                        Background="{Binding SelectedSegment.Sensor, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=None}"
                        Foreground="{Binding SelectedSegment.Sensor, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=None}"
                        Command="{Binding SetSensorCommand}" CommandParameter="None" />
                <Button Grid.Column="1" Content="Farbe" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedSegment.Sensor, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Color}"
                        Foreground="{Binding SelectedSegment.Sensor, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Color}"
                        Command="{Binding SetSensorCommand}" CommandParameter="Color" />
                <Button Grid.Column="2" Content="Abstand" Style="{StaticResource SegmentPillButtonStyle}" Margin="-1,0,0,0"
                        Background="{Binding SelectedSegment.Sensor, Converter={StaticResource SegmentBackgroundConverter}, ConverterParameter=Distance}"
                        Foreground="{Binding SelectedSegment.Sensor, Converter={StaticResource SegmentForegroundConverter}, ConverterParameter=Distance}"
                        Command="{Binding SetSensorCommand}" CommandParameter="Distance" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="18" Visibility="{Binding SelectedSegment.HasSensor, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Spacing="8">
                <TextBlock Text="Aktion beim Auslösen" Style="{StaticResource LabelTextBlockStyle}" />
                <ComboBox ItemsSource="{Binding SensorActionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedSegment.Action, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Spacing="10" Visibility="{Binding SelectedSegment.ShowSlowTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Ziel-Tempo" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{Binding SelectedSegment.SlowTarget}" FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="%" FontFamily="{StaticResource MonoFontFamily}" FontSize="15" FontWeight="Bold" />
                  </StackPanel>
                </Grid>
                <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{Binding SelectedSegment.SlowTarget, Mode=TwoWay}" />
              </StackPanel>

              <TextBlock Text="{Binding SelectedSegment.SensorToken}" Style="{StaticResource MonoCaptionTextBlockStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>
        </ScrollViewer>
        </local:BlueprintFrame>

        <Grid Grid.Row="6" ColumnSpacing="8" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Duplizieren" Style="{StaticResource IconButtonStyle}" Width="Auto" Height="40"
                  Command="{Binding DuplicateSegmentCommand}" CommandParameter="{Binding SelectedSegment}" />
          <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Nach oben"
                  Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedSegment}">
            <FontIcon Glyph="&#xE74A;" FontSize="13" />
          </Button>
          <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Nach unten"
                  Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedSegment}">
            <FontIcon Glyph="&#xE74B;" FontSize="13" />
          </Button>
          <Button Grid.Column="3" Content="Löschen" Style="{StaticResource IconButtonStyle}" Width="Auto" Height="40" Foreground="{ThemeResource ErrorBrush}"
                  Command="{Binding DeleteSegmentCommand}" CommandParameter="{Binding SelectedSegment}" />
        </Grid>

      </Grid>
    </ScrollViewer>

    <StackPanel Visibility="{Binding SelectedSegment, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
      <TextBlock Text="Kein Segment ausgewählt." FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
