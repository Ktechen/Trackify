<UserControl x:Class="Trackify.Presentation.Components.TrackCanvas"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:Trackify.Presentation.Behaviors"
             xmlns:widgets="using:Trackify.Presentation.Widgets"
             xmlns:vm="using:Trackify.Presentation.ViewModels"
             xmlns:models="using:Trackify.Models.Trains"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecondViewModel}">

  <!-- The drawing surface. You pull from a glowing Andockpunkt and real LEGO parts follow the
       stroke; nothing here is free-form. Binds to the hosting SecondViewModel. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <widgets:BlueprintFrame Grid.Row="0" Margin="24,24,24,12">
      <Border Background="{ThemeResource SurfaceVariantBrush}"
              BorderBrush="{ThemeResource OutlineVariantBrush}"
              BorderThickness="1">
        <Grid>
          <!-- Zoom is a plain bound size, not an imperative ScrollViewer.ChangeView call — that API
               isn't reliably supported on every Uno target. The Viewbox scales the fixed
               900x600-coordinate canvas; the ScrollViewer just scrolls. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Viewbox Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Stretch="Uniform">

              <!-- The gesture behavior sits on the Canvas itself, so points arrive in canvas
                   coordinates and the zoom never has to be undone by hand. Background="Transparent"
                   is what makes the empty area hit-testable at all. -->
              <Canvas Width="900" Height="600" Background="Transparent"
                      behaviors:DrawGestureBehavior.StartCommand="{Binding ElementName=Root, Path=DataContext.DrawStartCommand}"
                      behaviors:DrawGestureBehavior.MoveCommand="{Binding ElementName=Root, Path=DataContext.DrawMoveCommand}"
                      behaviors:DrawGestureBehavior.EndCommand="{Binding ElementName=Root, Path=DataContext.DrawEndCommand}">

                <!-- Ballast behind the coloured rail. -->
                <Path Data="{Binding BedPathData}" Stroke="{ThemeResource OutlineVariantBrush}"
                      StrokeThickness="26" IsHitTestVisible="False" />

                <!-- Selection halo. -->
                <Path Data="{Binding SelectedPiece.HitPathData}" Stroke="{ThemeResource PrimaryBrush}"
                      StrokeThickness="34" Opacity=".26" IsHitTestVisible="False"
                      Visibility="{Binding SelectedPiece, Converter={StaticResource NullToVisibilityConverter}}" />

                <!-- Rail, coloured by top speed. -->
                <ItemsControl ItemsSource="{Binding Pieces}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Path d:DataContext="{d:DesignInstance Type=models:TrackPiece}"
                            Data="{Binding PathData}"
                            Stroke="{Binding SpeedColor, Converter={StaticResource HexToBrushConverter}}"
                            StrokeThickness="19" IsHitTestVisible="False" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The run the current drag proposes: real parts, shown before they are committed. -->
                <Path Data="{Binding PreviewPathData}" Stroke="{ThemeResource PrimaryBrush}"
                      StrokeThickness="19" Opacity=".45" StrokeDashArray="2,1.4"
                      IsHitTestVisible="False" />

                <!-- Invisible fat strokes so a piece is easy to tap. -->
                <ItemsControl ItemsSource="{Binding Pieces}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Path d:DataContext="{d:DesignInstance Type=models:TrackPiece}"
                            Data="{Binding HitPathData}" Stroke="Transparent" StrokeThickness="34"
                            behaviors:TappedCommandBehavior.Command="{Binding ElementName=Root, Path=DataContext.SelectPieceCommand}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Top speed per piece. -->
                <ItemsControl ItemsSource="{Binding Pieces}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- Width matches TrackPiece's LabelWidth, which is what LabelLeft centres on. -->
                      <TextBlock d:DataContext="{d:DesignInstance Type=models:TrackPiece}"
                                 Text="{Binding MaxSpeed}" Width="40" TextAlignment="Center"
                                 FontSize="15" FontWeight="Bold" IsHitTestVisible="False"
                                 Foreground="{ThemeResource OnSurfaceBrush}"
                                 Canvas.Left="{Binding LabelLeft}" Canvas.Top="{Binding LabelTop}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sensor markers. -->
                <ItemsControl ItemsSource="{Binding Pieces}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid d:DataContext="{d:DesignInstance Type=models:TrackPiece}"
                            Width="28" Height="28"
                            Canvas.Left="{Binding SensorLeft}" Canvas.Top="{Binding SensorTop}"
                            Visibility="{Binding HasSensor, Converter={StaticResource BoolToVisibilityConverter}}"
                            behaviors:TappedCommandBehavior.Command="{Binding ElementName=Root, Path=DataContext.SelectPieceCommand}">
                        <Ellipse Fill="{Binding SensorColor, Converter={StaticResource HexToBrushConverter}}"
                                 Stroke="{ThemeResource SurfaceBrush}" StrokeThickness="2.5" />
                        <TextBlock Text="{Binding SensorGlyph}" FontSize="12.5" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ANDOCKPUNKTE — the open ends. Drag from one to build; tap one to aim the
                     "anhängen" buttons at it. Drawn last so they sit above the rail. -->
                <ItemsControl ItemsSource="{Binding Anchors}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid d:DataContext="{d:DesignInstance Type=models:TrackAnchor}"
                            Width="30" Height="30"
                            Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                            behaviors:TappedCommandBehavior.Command="{Binding ElementName=Root, Path=DataContext.SelectAnchorCommand}">
                        <Ellipse Fill="{ThemeResource PrimaryBrush}" Opacity=".22" />
                        <Ellipse Width="16" Height="16" Fill="{ThemeResource PrimaryBrush}"
                                 Stroke="{ThemeResource SurfaceBrush}" StrokeThickness="3" />
                        <!-- The aimed-at end gets a ring, so "anhängen" is never a guess. -->
                        <Ellipse Stroke="{ThemeResource PrimaryBrush}" StrokeThickness="2.5"
                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Canvas>
            </Viewbox>
          </ScrollViewer>

          <!-- Zoom -->
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Spacing="6">
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomInCommand}" ToolTipService.ToolTip="Vergrößern">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTipService.ToolTip="Verkleinern">
              <FontIcon Glyph="&#xE738;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomFitCommand}" ToolTipService.ToolTip="Einpassen">
              <FontIcon Glyph="&#xE9A6;" FontSize="14" />
            </Button>
          </StackPanel>

          <!-- How to use it, in one sentence, while the plan is still tiny. -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                  Background="{ThemeResource PrimaryContainerBrush}" Padding="16,9"
                  Visibility="{Binding IsPlanTiny, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Zieh von einem leuchtenden Punkt — die Strecke entsteht aus echten LEGO-Teilen."
                       FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
          </Border>

          <!-- Only ever shown when the user's own connections contradict the geometry. -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56"
                  Background="#E5484D" Padding="16,9"
                  Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Problem}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
          </Border>

          <!-- Legend -->
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"
                  Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}"
                  BorderThickness="1" Padding="14,9">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="Tempo" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Legend}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="14" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" d:DataContext="{d:DesignInstance Type=vm:LegendItem}">
                      <Border Width="12" Height="12" Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </widgets:BlueprintFrame>

    <!-- TOOLBAR — undo/redo and closing the loop first, because they are what rescue a wrong turn;
         then the parts a gesture never guesses, then whole starting layouts. -->
    <StackPanel Grid.Row="1" Margin="24,0,24,18" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0"
                Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTipService.ToolTip="Zurücknehmen">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="&#xE7A7;" FontSize="13" />
            <TextBlock Text="Zurück" FontSize="12.5" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0"
                Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTipService.ToolTip="Wiederholen">
          <FontIcon Glyph="&#xE7A6;" FontSize="13" />
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="14,0"
                Command="{Binding CloseLoopCommand}" IsEnabled="{Binding CanCloseLoop}"
                ToolTipService.ToolTip="Die fehlenden Teile einsetzen, bis der Kreis zu ist">
          <TextBlock Text="Kreis schließen" FontSize="12.5" />
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="14,0"
                Command="{Binding DeletePieceCommand}" IsEnabled="{Binding HasSelection}">
          <TextBlock Text="Teil löschen" FontSize="12.5" />
        </Button>
      </StackPanel>

      <TextBlock Text="Am gewählten Punkt anhängen" Style="{StaticResource LabelTextBlockStyle}" Margin="0,4,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Gerade"
                Command="{Binding AddStraightCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Kurve links"
                Command="{Binding AddCurveLeftCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Kurve rechts"
                Command="{Binding AddCurveRightCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Weiche links"
                Command="{Binding AddSwitchLeftCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Weiche rechts"
                Command="{Binding AddSwitchRightCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Kreuzung"
                Command="{Binding AddCrossingCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="38" Padding="13,0" Content="Bahnhof"
                Command="{Binding AddStationCommand}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="34" Padding="12,0" Content="Oval"
                Command="{Binding TemplateOvalCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="34" Padding="12,0" Content="Strecke"
                Command="{Binding TemplateLineCommand}" />
        <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="34" Padding="12,0" Content="Leeren"
                Command="{Binding ClearCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
