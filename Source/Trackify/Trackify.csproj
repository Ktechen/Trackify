<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop;net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- App and CLI compose the same layers (incl. Trackify.Infrastructure) to share the SQLite
             store. That pulls Tmds.DBus (BLE, never run off-Linux) and SQLitePCLRaw transitively, both
             flagged NU1903 — accepted repo-wide (as in Infrastructure/CLI), so don't fail the build. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>

        <!-- Uno.Sdk pins Microsoft.Windows.Compatibility to 10.0.7 for the browserwasm head only
             (its packages.json group "WindowsCompatibility"), and that carries
             System.Security.Cryptography.Pkcs 10.0.7 — GHSA-2fmv-rv2c-59x7, raised as NU1902 and
             therefore a build error here. 10.0.13 is the first patched 10.0.x, set through the SDK's
             own per-group override so no direct reference to a package we never call is needed.
             Drop this line once the Uno.Sdk pinned in global.json ships 10.0.13 or newer. -->
        <WindowsCompatibilityVersion>10.0.13</WindowsCompatibilityVersion>

        <!-- Display name -->
        <ApplicationTitle>Trackify</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.ktechen.trackify</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <!-- Package Publisher -->
        <ApplicationPublisher>Trackify</ApplicationPublisher>
        <!-- Package Description -->
        <Description>Trackify powered by Uno Platform.</Description>

        <!--
          UnoFeatures are used to quickly add and manage features enabled for your app.
          https://aka.platform.uno/singleproject-features
        -->
        <UnoFeatures>
            Material;
            Toolkit;
            Hosting;
            Mvvm;
            Configuration;
            Localization;
            Navigation;
            ThemeService;
            SkiaRenderer;
        </UnoFeatures>
    </PropertyGroup>

    <!-- App icon and splash screen (Uno.Resizetizer). Sources live in Assets/Icons and Assets/Splash.
         The background colour is the same value as the fill of Assets/Icons/icon.svg. -->
    <PropertyGroup>
        <TrackifyBrandColor>#1D2D3D</TrackifyBrandColor>
        <UnoSplashScreenColor>$(TrackifyBrandColor)</UnoSplashScreenColor>
        <!-- Phones: icon.svg is a full-bleed square and the OS masks it (Android adaptive shapes, iOS
             squircle). The opaque Color keeps the iOS 1024 marketing icon free of transparent pixels,
             which App Store Connect rejects. icon.svg must keep its name: Info.plist points at
             Assets.xcassets/icon.appiconset and the Android Application attribute at @mipmap/icon. -->
        <UnoIconBackgroundColor>$(TrackifyBrandColor)</UnoIconBackgroundColor>
        <!-- The icon sources are build inputs only. Without this, the default UnoImage glob turns
             icon_foreground.svg (and whichever background a head does not use) into in-app images. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);$(AssetsFolder)Icons\**</DefaultItemExcludes>
    </PropertyGroup>
    <!-- Windows, desktop and web: nothing masks the icon there, so it brings its own rounded corners
         on a transparent canvas, and the glyph gets some air from the edge. -->
    <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows' Or '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'desktop' Or '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browserwasm'">
        <UnoIconBackgroundFile>$(AssetsFolder)Icons\icon_rounded.svg</UnoIconBackgroundFile>
        <UnoIconBackgroundColor>#00000000</UnoIconBackgroundColor>
        <UnoIconForegroundScale>0.80</UnoIconForegroundScale>
    </PropertyGroup>

    <!-- The app no longer does Bluetooth: train control lives in the CLI on the Raspberry Pi. It
         registers a no-op ILegoService (Services/UnsupportedLegoService) so the UI still runs. -->

    <!-- High-performance logging (source-generated LoggerMessage) with a Serilog backend. -->
    <ItemGroup>
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Console" />
    </ItemGroup>

    <!-- Server mode: talk to a Trackify backend (the CLI on a Pi) over REST (Refit) + SignalR. -->
    <ItemGroup>
        <PackageReference Include="Refit" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    </ItemGroup>

    <!-- Clean Architecture shared core. The app composes the SAME layers as the CLI (Domain +
         Application + Infrastructure) so both share the SQLite store; AddLinuxLego inside
         AddTrackifyInfrastructure only wires BlueZ at runtime on Linux (a no-op on the app heads). -->
    <ItemGroup>
        <ProjectReference Include="..\Trackify.Domain\Trackify.Domain.csproj" />
        <ProjectReference Include="..\Trackify.Application\Trackify.Application.csproj" />
        <ProjectReference Include="..\Trackify.Infrastructure\Trackify.Infrastructure.csproj" />
    </ItemGroup>

</Project>
