<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop;net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- App and CLI compose the same layers (incl. Trackify.Infrastructure) to share the SQLite
             store. That pulls Tmds.DBus (BLE, never run off-Linux) and SQLitePCLRaw transitively, both
             flagged NU1903 — accepted repo-wide (as in Infrastructure/CLI), so don't fail the build. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>

        <!-- Uno.Sdk pins Microsoft.Windows.Compatibility to 10.0.7 for the browserwasm head only
             (its packages.json group "WindowsCompatibility"), and that carries
             System.Security.Cryptography.Pkcs 10.0.7 — GHSA-2fmv-rv2c-59x7, raised as NU1902 and
             therefore a build error here. 10.0.13 is the first patched 10.0.x, set through the SDK's
             own per-group override so no direct reference to a package we never call is needed.
             Drop this line once the Uno.Sdk pinned in global.json ships 10.0.13 or newer. -->
        <WindowsCompatibilityVersion>10.0.13</WindowsCompatibilityVersion>

        <!-- Display name -->
        <ApplicationTitle>Trackify</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.ktechen.trackify</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <!-- Package Publisher -->
        <ApplicationPublisher>Trackify</ApplicationPublisher>
        <!-- Package Description -->
        <Description>Züge per Bluetooth steuern und Gleispläne zeichnen.</Description>

        <!--
          UnoFeatures are used to quickly add and manage features enabled for your app.
          https://aka.platform.uno/singleproject-features
        -->
        <UnoFeatures>
            Material;
            Toolkit;
            Hosting;
            Mvvm;
            Configuration;
            Localization;
            Navigation;
            ThemeService;
            SkiaRenderer;
        </UnoFeatures>
    </PropertyGroup>

    <!-- Android Release (the AAB for Google Play): .NET SDK 10.0.2xx adds the host RID (win-x64) to
         RuntimeIdentifiers whenever PublishTrimmed is on, and restore then looks for a
         Microsoft.NETCore.App.Runtime.Mono.win-x64 pack that does not exist (NU1102). The Android
         workload opts out of this itself from 36.1.30 on (dotnet/android#10722); this line covers an
         older installed workload. Drop it once every build machine runs workload 36.1.30 or newer. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    </PropertyGroup>

    <!-- Bluetooth runs on the device heads: AddTrackifyApplication registers the local ILegoService
         transport for android/ios (Plugin.BLE) and windows (WinRT); wasm has none, and desktop only
         on Linux (BlueZ, via AddTrackifyInfrastructure). Server
         mode (Services/Remote) talks to the CLI backend on a Pi instead. That is why the store
         manifests declare Bluetooth and network access. -->

    <!-- High-performance logging (source-generated LoggerMessage) with a Serilog backend. -->
    <ItemGroup>
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Console" />
    </ItemGroup>

    <!-- Server mode: talk to a Trackify backend (the CLI on a Pi) over REST (Refit) + SignalR. -->
    <ItemGroup>
        <PackageReference Include="Refit" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    </ItemGroup>

    <!-- Clean Architecture shared core. The app composes the SAME layers as the CLI (Domain +
         Application + Infrastructure) so both share the SQLite store; AddLinuxLego inside
         AddTrackifyInfrastructure only wires BlueZ at runtime on Linux (a no-op on the app heads). -->
    <ItemGroup>
        <ProjectReference Include="..\Trackify.Domain\Trackify.Domain.csproj" />
        <ProjectReference Include="..\Trackify.Application\Trackify.Application.csproj" />
        <ProjectReference Include="..\Trackify.Infrastructure\Trackify.Infrastructure.csproj" />
    </ItemGroup>

</Project>
