<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <!--
    "Industry" palette — seeded from accent #5980a6, matching the claude.ai/design import
    "Trackify Mobile.dc.html" (design-system tokens in _ds/industry-.../styles.css). Same Material
    role names as before (Farb-Rollen) so every {ThemeResource ...Brush} binding in the app repaints
    without touching page XAML. The source doc has no dark variant; Dark below is a same-hue
    extrapolation (darker neutrals, lighter accent step) rather than a value pulled from the design.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#5980A6</Color>
      <Color x:Key="OnPrimaryColor">#F2F2F3</Color>
      <Color x:Key="PrimaryContainerColor">#EEF6FF</Color>
      <Color x:Key="OnPrimaryContainerColor">#2C455D</Color>
      <Color x:Key="SecondaryColor">#728FAB</Color>
      <Color x:Key="OnSecondaryColor">#F2F2F3</Color>
      <Color x:Key="SecondaryContainerColor">#EEF6FF</Color>
      <Color x:Key="OnSecondaryContainerColor">#314457</Color>
      <Color x:Key="TertiaryColor">#486077</Color>
      <Color x:Key="OnTertiaryColor">#F2F2F3</Color>
      <Color x:Key="TertiaryContainerColor">#D6EBFF</Color>
      <Color x:Key="OnTertiaryContainerColor">#1F2D3A</Color>
      <Color x:Key="ErrorColor">#E5484D</Color>
      <Color x:Key="ErrorContainerColor">#FBE0E0</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#7A1E20</Color>
      <Color x:Key="BackgroundColor">#F2F2F3</Color>
      <Color x:Key="OnBackgroundColor">#1D1F20</Color>
      <Color x:Key="SurfaceColor">#E9E9EA</Color>
      <Color x:Key="OnSurfaceColor">#1D1F20</Color>
      <Color x:Key="SurfaceVariantColor">#E7E7EA</Color>
      <Color x:Key="OnSurfaceVariantColor">#5D5D60</Color>
      <Color x:Key="OutlineColor">#98989B</Color>
      <Color x:Key="OnSurfaceInverseColor">#F2F2F3</Color>
      <Color x:Key="SurfaceInverseColor">#1D2D3D</Color>
      <Color x:Key="PrimaryInverseColor">#B5D9FD</Color>
      <Color x:Key="SurfaceTintColor">#5980A6</Color>
      <Color x:Key="OutlineVariantColor">#DADADB</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#94BCE3</Color>
      <Color x:Key="OnPrimaryColor">#1D2D3D</Color>
      <Color x:Key="PrimaryContainerColor">#2C455D</Color>
      <Color x:Key="OnPrimaryContainerColor">#EEF6FF</Color>
      <Color x:Key="SecondaryColor">#9EBBD8</Color>
      <Color x:Key="OnSecondaryColor">#1F2D3A</Color>
      <Color x:Key="SecondaryContainerColor">#314457</Color>
      <Color x:Key="OnSecondaryContainerColor">#EEF6FF</Color>
      <Color x:Key="TertiaryColor">#7E9CB8</Color>
      <Color x:Key="OnTertiaryColor">#1F2D3A</Color>
      <Color x:Key="TertiaryContainerColor">#486077</Color>
      <Color x:Key="OnTertiaryContainerColor">#EEF6FF</Color>
      <Color x:Key="ErrorColor">#F2A0A3</Color>
      <Color x:Key="ErrorContainerColor">#5A1416</Color>
      <Color x:Key="OnErrorColor">#3D0A0B</Color>
      <Color x:Key="OnErrorContainerColor">#FBE0E0</Color>
      <Color x:Key="BackgroundColor">#1D1F20</Color>
      <Color x:Key="OnBackgroundColor">#F2F2F3</Color>
      <Color x:Key="SurfaceColor">#424244</Color>
      <Color x:Key="OnSurfaceColor">#F2F2F3</Color>
      <Color x:Key="SurfaceVariantColor">#5D5D60</Color>
      <Color x:Key="OnSurfaceVariantColor">#D4D4D7</Color>
      <Color x:Key="OutlineColor">#98989B</Color>
      <Color x:Key="OnSurfaceInverseColor">#1D1F20</Color>
      <Color x:Key="SurfaceInverseColor">#F5F5F8</Color>
      <Color x:Key="PrimaryInverseColor">#597EA3</Color>
      <Color x:Key="SurfaceTintColor">#94BCE3</Color>
      <Color x:Key="OutlineVariantColor">#5D5D60</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
